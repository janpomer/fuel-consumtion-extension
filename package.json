{
  "name": "fuel-consumption-extension",
  "version": "0.1.0",
  "description": "Chrome extension that estimates fuel used and its cost for the route shown in Google Maps directions.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/build.mjs",
    "test": "node --test tests/",
    "package": "node scripts/build.mjs && node scripts/zip.mjs",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.279",
    "typescript": "^5.6.0"
  }
}
